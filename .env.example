# ─── Sitio ───────────────────────────────────────────────
# URL pública (canonical, sitemap, Open Graph). Editable también en el panel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Seguridad del panel ─────────────────────────────────
# Obligatorio en producción. Genera uno con: openssl rand -base64 48
SESSION_SECRET=
# Primera cuenta de administración (solo se usa si aún no existe ningún usuario).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Alternativa: permite el formulario de configuración inicial en producción con este token.
ADMIN_SETUP_TOKEN=

# ─── Almacenamiento ──────────────────────────────────────
# Sin Supabase se usan ficheros JSON en DATA_DIR (válido para desarrollo o un servidor con disco persistente).
DATA_DIR=./data
# Producción / serverless: ejecuta supabase/schema.sql y rellena estas variables (solo servidor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ─── Google (opcional; también configurable en el panel) ─
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# ─── Detección de noticias ───────────────────────────────
# Protege /api/cron/ingest (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# Opcional: asistente de borradores con Claude. Nunca publica nada por sí mismo.
ANTHROPIC_API_KEY=

# ─── Imágenes ────────────────────────────────────────────
# Wikimedia Commons y Openverse funcionan sin clave (requieren salida a internet
# hacia commons.wikimedia.org, upload.wikimedia.org y api.openverse.org).
# Correo de contacto para el User-Agent que exige la política de Wikimedia.
IMAGE_CONTACT_EMAIL=
# Opcional: más cuota en Openverse.
OPENVERSE_TOKEN=
# Opcionales: bancos de fotografía (api.pexels.com, api.unsplash.com).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Solo pruebas locales: permite importar imágenes desde la red privada.
IMAGE_IMPORT_ALLOW_PRIVATE=
