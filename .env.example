# ─── Obligatorias en Netlify ─────────────────────────────
# Secreto de las sesiones del panel. Genera uno con: openssl rand -base64 48
SESSION_SECRET=
# Secreto interno entre la web y las funciones de Netlify. Otro valor aleatorio.
STORE_SECRET=
# Tu primera cuenta del panel (se crea al entrar por primera vez).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Supabase (opcional: recetas, ajustes y fotos) ─
# Supabase → Project Settings → API. Ejecuta antes supabase/schema.sql.
# Sin estas dos variables, en Netlify se usa Netlify Blobs.
SUPABASE_URL=https://moailacnffcohjbsfoyd.supabase.co
# Clave «service_role» (secreta: solo en Netlify, nunca en el código ni en el navegador).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Opcionales ──────────────────────────────────────────
# Dirección pública de la web (también se cambia en Panel → Ajustes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Asistente de redacción con IA (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=

# ─── Solo desarrollo local ───────────────────────────────
# Carpeta donde se guardan recetas, ajustes y fotos sin Netlify.
DATA_DIR=./data
